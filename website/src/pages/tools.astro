---
import "../styles/global.css";
import ArtworkGenerator from "@/components/artwork-generator";
import Layout from "@/layouts/main.astro";
---

<Layout>
  <div class="min-h-screen py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 space-y-4">
        <h1 class="text-2xl font-light opacity-90">artwork generator</h1>
        <p class="text-sm opacity-60 max-w-xl mx-auto">
          create minimalist cover art for your sound journals
        </p>
      </div>
      <ArtworkGenerator client:load />
    </div>
  </div>
</Layout>

---
import SoundGallery from "@/components/how-it-sounds/SoundGallery";
import Container from "@/layouts/container.astro";
import Layout from "@/layouts/main.astro";

export const prerender = false;

const apiBaseUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";
---

<Layout title="public sounds — numa">
  <Container>
    <SoundGallery client:load apiBaseUrl={apiBaseUrl} />
  </Container>
</Layout>

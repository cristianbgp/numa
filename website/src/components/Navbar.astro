---
import Container from "@/layouts/container.astro";
import MobileMenu from "@/components/MobileMenu";

const currentPath = Astro.url.pathname;
---

<nav
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-sm bg-background/80 border-b border-border/50"
>
  <Container class="flex items-center justify-between py-4">
    <a href="/" class="text-sm font-medium hover:opacity-70 transition-opacity">
      numa
    </a>

    <!-- Mobile Menu -->
    <MobileMenu client:load currentPath={currentPath} />

    <!-- Desktop Menu -->
    <div class="hidden md:flex gap-6 text-sm">
      <a
        href="/"
        class:list={[
          "hover:opacity-70 transition-opacity",
          currentPath === "/" && "opacity-50",
        ]}
      >
        home
      </a>
      <a
        href="/mixes"
        class:list={[
          "hover:opacity-70 transition-opacity",
          currentPath === "/mixes" && "opacity-50",
        ]}
      >
        mixes
      </a>
      <a
        href="/about"
        class:list={[
          "hover:opacity-70 transition-opacity",
          currentPath === "/about" && "opacity-50",
        ]}
      >
        about
      </a>
      <a
        href="/tools"
        class:list={[
          "hover:opacity-70 transition-opacity",
          currentPath === "/tools" && "opacity-50",
        ]}
      >
        tools
      </a>
      <a
        href="/how-it-sounds"
        class:list={[
          "hover:opacity-70 transition-opacity",
          currentPath.startsWith("/how-it-sounds") && "opacity-50",
        ]}
      >
        how it sounds
      </a>
    </div>
  </Container>
</nav>

{
  "name": "@numa/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test test --timeout 10000",
    "test:db": "RUN_DATABASE_INTEGRATION=1 bun test test/postgres-result-store.test.ts test/rate-limit.test.ts --timeout 30000",
    "test:integration": "RUN_ELEVENLABS_INTEGRATION=1 bun test test/integration.test.ts --timeout 180000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.9",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "@types/node": "^24.10.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2"
  }
}
